{
    "name": "@azdias/config",
    "description": "Common `azdias` configurations for web development.",
    "author": {
        "name": "Lucas Dias",
        "email": "lucas@azdias.com.br",
        "url": "https://azdias.com.br"
    },
    "license": "No license",
    "private": true,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "type": "module",
    "files": [
        "dist"
    ],
    "scripts": {
        "postinstall": "pnpm install-prettier",
        "build": "tsc -b && pnpm install-prettier",
        "lint": "tsc && eslint",
        "install-prettier": "node scripts/install-prettier.ts"
    },
    "peerDependencies": {
        "eslint": "catalog:",
        "typescript": "catalog:"
    },
    "dependencies": {
        "@eslint/css": "^1.4.0",
        "@eslint/js": "^10.0.1",
        "@eslint/markdown": "^8.0.3",
        "@html-eslint/eslint-plugin": "^0.64.0",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/node": "^26.1.1",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jsonc": "^3.3.0",
        "eslint-plugin-perfectionist": "^5.10.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.3",
        "eslint-plugin-yml": "^3.6.0",
        "globals": "^17.7.0",
        "typescript-eslint": "^8.63.0"
    },
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "keywords": [
        "repository",
        "configurations"
    ]
